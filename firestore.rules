rules_version = '2';

// Правила безопасности Firestore. Сервер Firebase проверяет их при КАЖДОМ чтении и записи,
// поэтому обойти их из браузера нельзя (в отличие от проверок в Angular-коде).
// Пока вставляем вручную: Firebase Console → Firestore Database → Rules → Publish.
//
// Осторожно: match, in, is, if — зарезервированные слова, ими нельзя называть параметры функций.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Есть ли мэтч между a и b. id мэтча — два uid через '_' по алфавиту; проверяем оба порядка на всякий случай.
    // exists() смотрит в базу в обход правил, поэтому права на чтение matches здесь не нужны.
    function isMatched(a, b) {
      return exists(/databases/$(database)/documents/matches/$(a + '_' + b))
        || exists(/databases/$(database)/documents/matches/$(b + '_' + a));
    }

    function liked(from, to) {
      return exists(/databases/$(database)/documents/likes/$(from + '_' + to));
    }

    // Блокировка в любую сторону: кто-то из двоих заблокировал другого.
    function isBlocked(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    // Лайк, пропуск, блокировка: документ {from}_{to} только от своего имени, не себе,
    // ровно три поля, а время ставит сервер (serverTimestamp() равен request.time).
    function isOwnPairDoc(pairId) {
      let data = request.resource.data;
      return signedIn()
        && data.keys().hasOnly(['from', 'to', 'createdAt'])
        && data.from == request.auth.uid
        && data.to is string
        && data.to != request.auth.uid
        && data.createdAt == request.time
        && pairId == request.auth.uid + '_' + data.to;
    }

    // ===== Проверка анкеты на сервере — те же правила, что и в форме профиля =====

    // 'YYYY-MM-DD' и 18 лет уже исполнилось (сравниваем год, месяц, день по отдельности —
    // так не ломается день рождения 29 февраля).
    function isAdult(birthDate) {
      let parts = birthDate.split('-');
      let adultYear = int(parts[0]) + 18;
      let month = int(parts[1]);
      let day = int(parts[2]);
      let now = request.time;
      return adultYear < now.year()
        || (adultYear == now.year()
          && (month < now.month() || (month == now.month() && day <= now.day())));
    }

    function isValidProfile(profile) {
      return profile.keys().hasOnly(['name', 'birthDate', 'city', 'bio', 'photo', 'games',
          'platforms', 'genres', 'playTimes', 'updatedAt'])
        && profile.name is string && profile.name.size() > 0 && profile.name.size() <= 30
        && profile.birthDate is string && profile.birthDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && isAdult(profile.birthDate)
        && profile.city is string && profile.city.size() > 0 && profile.city.size() <= 50
        && profile.bio is string && profile.bio.size() <= 500
        // Фото — только сжатый JPEG из браузера (около 50 КБ), с запасом до 300 КБ.
        && (profile.photo == null
          || (profile.photo is string && profile.photo.size() <= 300000
            && profile.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        // Перебрать элементы списка правила не умеют — проверяем размер и допустимые значения.
        && profile.games is list && profile.games.size() > 0 && profile.games.size() <= 20
        && profile.platforms is list && profile.platforms.size() > 0
        && profile.platforms.hasOnly(['pc', 'playstation', 'xbox', 'switch', 'mobile'])
        && profile.genres is list && profile.genres.size() > 0
        && profile.genres.hasOnly(['shooter', 'rpg', 'mmo', 'moba', 'strategy', 'horror',
          'survival', 'sandbox', 'sports', 'racing', 'fighting', 'indie'])
        && profile.playTimes is list
        && profile.playTimes.hasOnly(['morning', 'day', 'evening', 'night', 'weekdays', 'weekends'])
        && profile.updatedAt == request.time;
    }

    // Контакт: пусто, ник (2–37 символов, без ':' и '/') или https-ссылка на сайт платформы.
    function isValidContact(value, domains) {
      return value is string && value.size() <= 200
        && (value == ''
          || value.matches('[\\p{L}\\p{N} _.\\-#]{2,37}')
          || value.matches('(?i)https://([a-z0-9-]+\\.)*(' + domains + ')([/?#].*)?'));
    }

    function isValidContacts(contacts) {
      return contacts.keys().hasOnly(['discord', 'steam', 'psn', 'xbox'])
        && isValidContact(contacts.get('discord', ''), 'discord\\.com|discord\\.gg')
        && isValidContact(contacts.get('steam', ''), 'steamcommunity\\.com')
        && isValidContact(contacts.get('psn', ''), 'playstation\\.com|psnprofiles\\.com')
        && isValidContact(contacts.get('xbox', ''), 'xbox\\.com|xboxgamertag\\.com');
    }

    // Публичная анкета: читать может любой вошедший, менять — только владелец и только правильную.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && isValidProfile(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;

      // Контакты (ники и ссылки): владелец и те, с кем у него мэтч.
      match /private/{docId} {
        allow read: if signedIn() && (request.auth.uid == uid || isMatched(request.auth.uid, uid));
        allow create, update: if signedIn() && request.auth.uid == uid && docId == 'contacts'
          && isValidContacts(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Лайк likes/{from}_{to}. get — по id: и тот, кто лайкнул, и тот, кого лайкнули
    // (uid состоит из букв и цифр, поэтому '_' однозначно делит id на две части).
    // list — свои лайки (from) и лайки МНЕ (to): из них уведомления «тебя лайкнули».
    match /likes/{likeId} {
      allow get: if signedIn() && request.auth.uid in likeId.split('_');
      allow list: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isOwnPairDoc(likeId);
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Пропуск skips/{from}_{to} — виден только тому, кто пропустил.
    match /skips/{skipId} {
      allow read: if signedIn() && resource.data.from == request.auth.uid;
      allow create: if isOwnPairDoc(skipId);
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Блокировка blocks/{from}_{to}. Видят обе стороны: так заблокированный тоже перестаёт
    // видеть того, кто его заблокировал. Снять блокировку может только тот, кто её поставил.
    match /blocks/{blockId} {
      allow get: if signedIn() && request.auth.uid in blockId.split('_');
      allow list: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isOwnPairDoc(blockId);
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Жалоба: только создать. Читать жалобы нельзя никому — их смотрит владелец проекта
    // в Firebase Console (там правила не действуют).
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'reason', 'comment', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.reason in ['fake', 'spam', 'offensive', 'underage', 'other']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt == request.time;
    }

    // Участник мэтча: его uid есть в массиве users документа мэтча.
    // Параметр не называем match — это зарезервированное слово правил (им начинаются блоки match /...).
    function isMember(matchData) {
      return signedIn() && request.auth.uid in matchData.users;
    }

    // Сообщение: только эти три поля, автор — я, текст 1–1000 символов, время ставит сервер.
    // request.time — время запроса; serverTimestamp() из браузера ему как раз равен.
    function isValidMessage(message) {
      return message.keys().hasOnly(['from', 'text', 'createdAt'])
        && message.from == request.auth.uid
        && message.text is string
        && message.text.size() > 0
        && message.text.size() <= 1000
        && message.createdAt == request.time;
    }

    // Мэтч создаётся, только если ОБА лайка уже лежат в базе и никто никого не заблокировал.
    match /matches/{matchId} {
      allow read, delete: if isMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'createdBy', 'createdAt'])
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && matchId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && liked(request.resource.data.users[0], request.resource.data.users[1])
        && liked(request.resource.data.users[1], request.resource.data.users[0])
        && !isBlocked(request.resource.data.users[0], request.resource.data.users[1]);

      // Менять готовый мэтч можно только участнику и только два поля:
      //  lastMessage — последнее сообщение (превью в списке мэтчей), обязательно от моего имени;
      //  readAt.{uid} — когда я последний раз читал чат; чужое время прочтения трогать нельзя.
      // users, createdBy и createdAt после создания не меняются.
      allow update: if isMember(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'readAt'])
        && (!('lastMessage' in request.resource.data.diff(resource.data).affectedKeys())
          || (isValidMessage(request.resource.data.lastMessage)))
        && request.resource.data.get('readAt', {}).diff(resource.data.get('readAt', {}))
          .affectedKeys().hasOnly([request.auth.uid]);

      // Сообщения чата. Читать и писать — только двоим участникам мэтча.
      // get() достаёт документ мэтча, чтобы узнать участников (это ещё одно чтение, оно платное).
      // Удалять может любой участник — например, вместе с мэтчем; менять сообщения нельзя.
      match /messages/{messageId} {
        allow read, delete: if isMember(get(/databases/$(database)/documents/matches/$(matchId)).data);
        allow create: if isMember(get(/databases/$(database)/documents/matches/$(matchId)).data)
          && isValidMessage(request.resource.data);
      }
    }
  }
}
